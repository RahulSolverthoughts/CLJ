    // 4. TEST EMAIL DISPATCH
    async function dispatchTestEmail() {
        const btn = document.getElementById('btn-test-email');
        const to = document.getElementById('test-email-to').value.trim();
        if (!to) {
            alert('Please enter recipient email address.');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader" style="font-size:13px"></i> Sending...';

        const payload = {
            to: to,
            subject: document.getElementById('test-email-subject').value.trim(),
            body: document.getElementById('test-email-body').value.trim()
        };

        try {
            const resp = await fetch('/api/v1/communication/test/email', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await resp.json();
            showTestResult('test-result-email', result, resp.ok && result.success);
        } catch (e) {
            showTestResult('test-result-email', { success: false, message: e.message }, false);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="ti ti-mail-fast" style="font-size:13px"></i> <span>Send Test Email</span>';
        }
    }

