@page
@model XMLAutoTagger.WebAPI.Pages.Settings.ChangePasswordModel
@{
    ViewData["Title"] = "Settings — Change Password";
    ViewData["ActivePage"] = "Settings";
    ViewData["PageHeading"] = "Account settings";
    ViewData["PageSubtitle"] = "Update your credentials to maintain account security";
    Layout = "_Layout";
    var user = Model.CurrentUser;
}

@Html.AntiForgeryToken()

<!-- Settings Sub-tabs -->
<div style="display:flex;gap:4px;border-bottom:0.5px solid var(--bd);margin:-18px -20px 18px;padding:0 20px;background:var(--sf)">
    <a href="/Settings" class="tab" style="text-decoration:none"><i class="ti ti-user" style="font-size:13px"></i>User profile</a>
    <a href="/Settings/ChangePassword" class="tab active" style="text-decoration:none"><i class="ti ti-key" style="font-size:13px"></i>Change password</a>
    <a href="/Settings/Communication" class="tab" style="text-decoration:none"><i class="ti ti-mail-fast" style="font-size:13px"></i>Communication channels</a>
</div>

<!-- TOP HERO / PROFILE SUMMARY CARD -->
<div class="card" style="margin-bottom:16px;padding:16px 20px;background:linear-gradient(135deg, #ffffff 0%, #f9f8f6 100%)">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px">
        <div style="display:flex;align-items:center;gap:14px">
            <div class="av" style="width:48px;height:48px;font-size:16px;font-weight:600;background:@(user?.AvatarColourHex ?? "#185FA5");color:#fff;box-shadow:0 2px 6px rgba(0,0,0,0.1)">
                @(user?.AvatarInitials ?? "U")
            </div>
            <div>
                <div style="display:flex;align-items:center;gap:8px">
                    <span style="font-size:15px;font-weight:600;color:var(--tp)">@(user?.FullName ?? "User")</span>
                    <span class="badge b-p" style="font-size:10.5px;font-weight:600">@(user?.RoleName ?? "Role")</span>
                </div>
                <div style="font-size:12px;color:var(--tm);margin-top:2px">
                    <span>@(user?.Email ?? "")</span>
                </div>
            </div>
        </div>

        <div>
            <a href="/Settings" class="btn btn-sm" style="text-decoration:none">
                <i class="ti ti-arrow-left" style="font-size:12px"></i>
                <span>Back to profile</span>
            </a>
        </div>
    </div>
</div>

<div style="display:grid;grid-template-columns:1.5fr 1fr;gap:16px">
    <!-- LEFT: CHANGE PASSWORD FORM -->
    <div class="card">
        <div class="card-hdr">
            <div class="card-title">
                <i class="ti ti-lock" style="color:var(--ta)"></i><span>Change account password</span>
            </div>
            <span class="badge b-s" style="font-size:10px"><i class="ti ti-shield-check"></i> Encrypted with BCrypt</span>
        </div>
        <div class="card-body">
            <div id="pw-alert" style="display:none;margin-bottom:14px"></div>

            <div class="form-row">
                <div class="form-label">Current password <span class="req">*</span></div>
                <div style="display:flex;gap:6px">
                    <input type="password" class="form-input" id="current-password" placeholder="Enter your current password" style="flex:1">
                    <button type="button" class="btn btn-sm" onclick="togglePassVisibility('current-password', this)" title="Show / hide password">
                        <i class="ti ti-eye"></i>
                    </button>
                </div>
                <div class="form-hint">Enter your existing account password to authorize the change.</div>
            </div>

            <div class="form-row" style="margin-top:14px">
                <div class="form-label">New password <span class="req">*</span></div>
                <div style="display:flex;gap:6px">
                    <input type="password" class="form-input" id="new-password" placeholder="Enter new password (min. 6 characters)" style="flex:1" oninput="checkStrength(this.value)">
                    <button type="button" class="btn btn-sm" onclick="togglePassVisibility('new-password', this)" title="Show / hide password">
                        <i class="ti ti-eye"></i>
                    </button>
                </div>
                <!-- Strength bar -->
                <div style="margin-top:6px;height:4px;background:var(--s2);border-radius:2px;overflow:hidden">
                    <div id="strength-bar" style="height:100%;width:0;background:var(--tr);transition:all .2s"></div>
                </div>
                <div id="strength-text" style="font-size:10.5px;color:var(--tm);margin-top:3px">Password strength: None</div>
            </div>

            <div class="form-row" style="margin-top:14px">
                <div class="form-label">Confirm new password <span class="req">*</span></div>
                <div style="display:flex;gap:6px">
                    <input type="password" class="form-input" id="confirm-password" placeholder="Re-enter new password to confirm" style="flex:1">
                    <button type="button" class="btn btn-sm" onclick="togglePassVisibility('confirm-password', this)" title="Show / hide password">
                        <i class="ti ti-eye"></i>
                    </button>
                </div>
            </div>

            <div style="margin-top:20px;display:flex;justify-content:flex-end;gap:8px">
                <a href="/Settings" class="btn btn-sm" style="text-decoration:none">Cancel</a>
                <button type="button" class="btn btn-sm btn-accent" id="btn-submit-pw" onclick="submitPasswordChange()">
                    <i class="ti ti-shield-check" style="font-size:12px"></i>
                    <span>Update password</span>
                </button>
            </div>
        </div>
    </div>

    <!-- RIGHT: PASSWORD SECURITY POLICY -->
    <div class="card">
        <div class="card-hdr">
            <div class="card-title">
                <i class="ti ti-shield-check" style="color:var(--tg)"></i><span>Security guidelines</span>
            </div>
        </div>
        <div class="card-body">
            <div style="font-size:12px;color:var(--ts);line-height:1.6">
                For security reasons, your new password should adhere to the following standards:
            </div>
            <ul style="margin:12px 0 16px 18px;font-size:11.5px;color:var(--ts);line-height:1.8">
                <li>Minimum of <strong>6 characters</strong> in length.</li>
                <li>Include at least one uppercase letter (A-Z).</li>
                <li>Include at least one number (0-9) or special symbol.</li>
                <li>Must not be identical to your current password.</li>
                <li>Avoid using personal names or common sequence words.</li>
            </ul>

            <div class="info-box">
                <i class="ti ti-info-circle" style="font-size:13px;flex-shrink:0;margin-top:1px"></i>
                <span>Changing your password will take effect immediately. You will stay signed in on this current browser session.</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function getCsrfToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function togglePassVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'ti ti-eye-off';
        } else {
            input.type = 'password';
            icon.className = 'ti ti-eye';
        }
    }

    function checkStrength(pwd) {
        const bar = document.getElementById('strength-bar');
        const text = document.getElementById('strength-text');
        if (!pwd) {
            bar.style.width = '0%';
            text.textContent = 'Password strength: None';
            return;
        }

        let score = 0;
        if (pwd.length >= 6) score += 25;
        if (pwd.length >= 10) score += 25;
        if (/[A-Z]/.test(pwd) && /[a-z]/.test(pwd)) score += 25;
        if (/[0-9]/.test(pwd) || /[^A-Za-z0-9]/.test(pwd)) score += 25;

        bar.style.width = score + '%';
        if (score <= 25) {
            bar.style.background = 'var(--tr)';
            text.textContent = 'Password strength: Weak';
        } else if (score <= 50) {
            bar.style.background = 'var(--tw)';
            text.textContent = 'Password strength: Medium';
        } else if (score <= 75) {
            bar.style.background = 'var(--ta)';
            text.textContent = 'Password strength: Strong';
        } else {
            bar.style.background = 'var(--tg)';
            text.textContent = 'Password strength: Very strong';
        }
    }

    async function submitPasswordChange() {
        const curPass = document.getElementById('current-password').value;
        const newPass = document.getElementById('new-password').value;
        const confPass = document.getElementById('confirm-password').value;
        const alertBox = document.getElementById('pw-alert');
        const btn = document.getElementById('btn-submit-pw');

        alertBox.style.display = 'none';

        if (!curPass) {
            showAlert('Please enter your current password.', false);
            return;
        }
        if (!newPass) {
            showAlert('Please enter your new password.', false);
            return;
        }
        if (newPass.length < 6) {
            showAlert('New password must be at least 6 characters.', false);
            return;
        }
        if (newPass !== confPass) {
            showAlert('New password and confirmation do not match.', false);
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="ti ti-loader animate-spin" style="font-size:12px"></i><span>Updating...</span>';

        try {
            const resp = await fetch('?handler=ChangePasswordJson', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: JSON.stringify({
                    currentPassword: curPass,
                    newPassword: newPass,
                    confirmPassword: confPass
                })
            });

            const data = await resp.json();

            if (resp.ok && data.success) {
                showAlert(data.message || 'Password changed successfully!', true);
                document.getElementById('current-password').value = '';
                document.getElementById('new-password').value = '';
                document.getElementById('confirm-password').value = '';
                checkStrength('');
            } else {
                showAlert(data.message || 'Failed to change password.', false);
            }
        } catch (e) {
            showAlert('Network error: ' + e.message, false);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="ti ti-shield-check" style="font-size:12px"></i><span>Update password</span>';
        }
    }

    function showAlert(msg, isSuccess) {
        const alertBox = document.getElementById('pw-alert');
        alertBox.className = isSuccess ? 'badge b-s' : 'badge b-d';
        alertBox.style.display = 'flex';
        alertBox.style.padding = '8px 12px';
        alertBox.style.fontSize = '12px';
        alertBox.style.gap = '6px';
        const icon = isSuccess ? 'ti-check' : 'ti-alert-triangle';
        alertBox.innerHTML = `<i class="ti ${icon}" style="font-size:14px"></i><span>${msg}</span>`;
    }
</script>
}
