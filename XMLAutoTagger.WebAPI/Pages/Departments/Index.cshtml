@page
@model XMLAutoTagger.WebAPI.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
    ViewData["ActivePage"] = "Departments";
    ViewData["PageHeading"] = "Department management";
    ViewData["PageSubtitle"] = $"{Model.Departments.Count} departments · {Model.TotalMembers} members";
    Layout = "_Layout";
}

@Html.AntiForgeryToken()

@section TopbarActions {
    @if (Model.CanEdit)
    {
        <button class="btn btn-sm" id="tb-add-btn" onclick="switchToAddMode()"><i class="ti ti-plus" style="font-size:11px"></i><span>Add department</span></button>
    }
    else
    {
        <span class="badge b-d" style="padding:4px 8px;font-size:11px;font-weight:600"><i class="ti ti-eye"></i> View only</span>
    }
}

<div class="sidebar-layout">
    <!-- LEFT: Department list -->
    <div style="position:relative">
        <div style="display:flex;flex-direction:column;gap:8px" id="dept-list">
            @if (Model.Departments.Count == 0)
            {
                <div style="padding:16px;text-align:center;color:var(--tm);background:var(--sf);border:.5px solid var(--bd);border-radius:8px">
                    No departments found.
                </div>
            }
            @foreach (var dept in Model.Departments)
            {
                <div class="item-card" id="card-@dept.DepartmentId" onclick="selectDepartment('@dept.DepartmentId')">
                    <div class="item-icon" style="background:@(dept.ColorHex)15;color:@dept.ColorHex">
                        <i class="ti @(string.IsNullOrEmpty(dept.Icon) ? "ti-building" : dept.Icon)"></i>
                    </div>
                    <div style="flex:1;min-width:0">
                        <div class="item-name">@dept.DepartmentName</div>
                        <div class="item-meta">@dept.MemberCount @(dept.MemberCount == 1 ? "member" : "members") · @dept.DocumentType</div>
                    </div>
                    <div class="item-actions">
                        <span class="badge @(dept.IsActive ? "b-s" : "b-n")">@(dept.IsActive ? "Active" : "Inactive")</span>
                    </div>
                </div>
            }
        </div>
        @if (Model.CanEdit)
        {
            <button class="btn btn-sm btn-accent" style="width:100%;justify-content:center;margin-top:10px" onclick="switchToAddMode()">
                <i class="ti ti-plus" style="font-size:11px"></i>New department
            </button>
        }
    </div>

    <!-- RIGHT: Department form -->
    <div style="position:relative">
        <div class="card">
            <div class="card-hdr">
                <div class="card-title" id="card-hdr-title">
                    <i class="ti ti-building" style="color:var(--ta)"></i><span id="title-text">Edit department</span>
                </div>
                <div style="display:flex;gap:6px">
                    @if (Model.CanEdit)
                    {
                        <button class="btn btn-xs btn-danger" id="btn-delete-dept" onclick="deleteDepartment()"><i class="ti ti-trash" style="font-size:10px"></i>Delete</button>
                        <button class="btn btn-xs btn-accent" id="btn-save-dept" onclick="saveDepartment()"><i class="ti ti-device-floppy" style="font-size:10px"></i>Save</button>
                    }
                    else
                    {
                        <span class="badge b-n" style="font-size:10.5px"><i class="ti ti-lock"></i> View only</span>
                    }
                </div>
            </div>
            <div class="card-body">
                <input type="hidden" id="dept-id">

                <div class="form-section"><i class="ti ti-info-circle" style="font-size:13px"></i>Basic information</div>
                <div class="g2">
                    <div class="form-row">
                        <div class="form-label">Department name <span class="req">*</span></div>
                        <input class="form-input" id="dept-name" placeholder="e.g. Case law division">
                    </div>
                    <div class="form-row">
                        <div class="form-label">Department code <span class="req">*</span></div>
                        <input class="form-input" id="dept-code" placeholder="e.g. DEPT-CL">
                        <div class="form-hint">Used in reports and audit logs</div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-label">Description</div>
                    <textarea class="form-textarea" id="dept-desc" placeholder="Responsible for tagging and publishing..."></textarea>
                </div>
                <div class="g2">
                    <div class="form-row">
                        <div class="form-label">Department head</div>
                        <select class="form-select" id="dept-head">
                            <option value="">Unassigned</option>
                            @foreach (var user in Model.Users)
                            {
                                <option value="@user.UserId">@user.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="form-row">
                        <div class="form-label">Status</div>
                        <select class="form-select" id="dept-status">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>

                <!-- Members Section -->
                <div id="members-section">
                    <div class="form-section" style="margin-top:14px">
                        <i class="ti ti-users" style="font-size:13px"></i>Members <span style="font-size:11px;font-weight:400;color:var(--tm);text-transform:none;letter-spacing:0" id="members-count">(0)</span>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:6px" id="members-list">
                        <!-- Populated dynamically -->
                    </div>
                    @if (Model.CanEdit)
                    {
                        <button class="btn btn-xs" style="align-self:flex-start;margin-top:8px" onclick="openAddMemberModal()">
                            <i class="ti ti-user-plus" style="font-size:10px"></i>Add member
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add Member -->
<div id="modal-add-member" class="modal-overlay" style="display:none">
    <div class="modal-box">
        <div class="card-hdr">
            <div class="card-title"><i class="ti ti-user-plus" style="color:var(--ta)"></i>Add member to department</div>
            <button class="btn btn-xs" onclick="closeAddMemberModal()"><i class="ti ti-x"></i></button>
        </div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-label">Select staff member</div>
                <select class="form-select" id="modal-select-user">
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.UserId">@user.FullName (@user.Email) — @user.DepartmentName</option>
                    }
                </select>
            </div>
            <div style="display:flex;justify-content:flex-end;gap:6px;margin-top:16px">
                <button class="btn btn-sm" onclick="closeAddMemberModal()">Cancel</button>
                <button class="btn btn-sm btn-accent" onclick="confirmAddMember()">Add member</button>
            </div>
        </div>
    </div>
</div>

<!-- Data Caches -->
<script id="departments-json" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Departments, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
</script>

@section Scripts {
<script>
    const canEdit = @(Model.CanEdit.ToString().ToLower());
    let departmentsData = JSON.parse(document.getElementById('departments-json')?.textContent || '[]');
    let currentDeptId = null;

    function getCsrfToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (departmentsData.length > 0) {
            selectDepartment(departmentsData[0].departmentId || departmentsData[0].DepartmentId);
        } else {
            switchToAddMode();
        }
    });

    function selectDepartment(id) {
        currentDeptId = id;
        const dept = departmentsData.find(d => (d.departmentId || d.DepartmentId) === id);
        if (!dept) return;

        // Highlight selected in left panel
        document.querySelectorAll('.item-card').forEach(c => c.classList.remove('selected'));
        const card = document.getElementById('card-' + id);
        if (card) card.classList.add('selected');

        // Update right form
        document.getElementById('dept-id').value = dept.departmentId || dept.DepartmentId;
        document.getElementById('title-text').textContent = (canEdit ? 'Edit department — ' : 'Department — ') + (dept.departmentName || dept.DepartmentName);
        document.getElementById('dept-name').value = dept.departmentName || dept.DepartmentName;
        document.getElementById('dept-name').disabled = !canEdit;
        document.getElementById('dept-code').value = dept.departmentCode || dept.DepartmentCode;
        document.getElementById('dept-code').disabled = !canEdit;
        document.getElementById('dept-desc').value = dept.description || dept.Description || '';
        document.getElementById('dept-desc').disabled = !canEdit;
        document.getElementById('dept-head').value = dept.headUserId || dept.HeadUserId || '';
        document.getElementById('dept-head').disabled = !canEdit;
        document.getElementById('dept-status').value = ((dept.isActive !== undefined ? dept.isActive : dept.IsActive) !== false) ? 'true' : 'false';
        document.getElementById('dept-status').disabled = !canEdit;

        const delBtn = document.getElementById('btn-delete-dept');
        if (delBtn) delBtn.style.display = canEdit ? 'inline-flex' : 'none';
        document.getElementById('members-section').style.display = 'block';

        renderMembers(dept.members || dept.Members || []);
    }

    function renderMembers(members) {
        const listEl = document.getElementById('members-list');
        document.getElementById('members-count').textContent = `(${members.length})`;

        if (!members || members.length === 0) {
            listEl.innerHTML = '<div style="font-size:11px;color:var(--tm);padding:6px 0">No members assigned to this department.</div>';
            return;
        }

        const avClasses = ['av-pu', 'av-bl', 'av-gr', 'av-am', 'av-co'];

        listEl.innerHTML = members.map((m, idx) => {
            const avClass = avClasses[idx % avClasses.length];
            const name = m.fullName || m.FullName || '';
            const role = m.roleName || m.RoleName || 'Editor';
            const initials = m.avatarInitials || m.AvatarInitials || name.substring(0, 2).toUpperCase();
            const uId = m.userId || m.UserId;

            const removeBtn = canEdit ? `
                <button class="btn btn-xs btn-danger" style="font-size:10px" onclick="removeMember('${uId}', '${name.replace(/'/g, "\\'")}')">
                    <i class="ti ti-x" style="font-size:9px"></i>Remove
                </button>
            ` : '';

            return `
                <div style="display:flex;align-items:center;gap:8px;background:var(--s2);border-radius:var(--r);padding:7px 10px">
                    <div class="av ${avClass}" style="width:24px;height:24px;font-size:9px">${initials}</div>
                    <span style="flex:1;font-size:12px">${name}</span>
                    <span class="badge b-p" style="font-size:10px">${role}</span>
                    ${removeBtn}
                </div>
            `;
        }).join('');
    }

    function switchToAddMode() {
        if (!canEdit) return;
        currentDeptId = null;
        document.querySelectorAll('.item-card').forEach(c => c.classList.remove('selected'));

        document.getElementById('dept-id').value = '';
        document.getElementById('title-text').textContent = 'New department';
        document.getElementById('dept-name').value = '';
        document.getElementById('dept-name').disabled = false;
        document.getElementById('dept-code').value = '';
        document.getElementById('dept-code').disabled = false;
        document.getElementById('dept-desc').value = '';
        document.getElementById('dept-desc').disabled = false;
        document.getElementById('dept-head').value = '';
        document.getElementById('dept-head').disabled = false;
        document.getElementById('dept-status').value = 'true';
        document.getElementById('dept-status').disabled = false;

        const delBtn = document.getElementById('btn-delete-dept');
        if (delBtn) delBtn.style.display = 'none';
        document.getElementById('members-section').style.display = 'none';
    }

    async function saveDepartment() {
        if (!canEdit) {
            alert('Access denied: You have view-only permission.');
            return;
        }
        const id = document.getElementById('dept-id').value;
        const name = document.getElementById('dept-name').value.trim();
        const code = document.getElementById('dept-code').value.trim();
        const desc = document.getElementById('dept-desc').value.trim();
        const head = document.getElementById('dept-head').value || null;
        const isActive = document.getElementById('dept-status').value === 'true';

        if (!name || !code) {
            alert('Department name and code are required.');
            return;
        }

        const isNew = !id;
        const url = isNew ? '?handler=CreateDepartmentJson' : '?handler=UpdateDepartmentJson';
        const payload = isNew ? {
            departmentName: name,
            departmentCode: code,
            description: desc,
            headUserId: head,
            isActive: isActive,
            icon: 'ti-building',
            colorHex: '#185FA5',
            docTypes: ['case_law']
        } : {
            departmentId: id,
            departmentName: name,
            departmentCode: code,
            description: desc,
            headUserId: head,
            isActive: isActive,
            icon: 'ti-building',
            colorHex: '#185FA5',
            docTypes: ['case_law']
        };

        const btn = document.getElementById('btn-save-dept');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="ti ti-loader animate-spin"></i> Saving...';
        }

        try {
            const resp = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: JSON.stringify(payload)
            });

            const res = await resp.json();
            if (resp.ok && (res.success || res.departmentId)) {
                window.location.reload();
            } else {
                alert('Error: ' + (res.message || 'Failed to save department.'));
            }
        } catch (e) {
            alert('Network error: ' + e.message);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="ti ti-device-floppy" style="font-size:10px"></i>Save';
            }
        }
    }

    async function deleteDepartment() {
        if (!canEdit) {
            alert('Access denied: You have view-only permission.');
            return;
        }
        const id = document.getElementById('dept-id').value;
        const name = document.getElementById('dept-name').value;
        if (!id) return;

        if (!confirm(`Are you sure you want to delete "${name}"?`)) return;

        try {
            const resp = await fetch('?handler=DeleteDepartmentJson', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: JSON.stringify({ departmentId: id })
            });

            const res = await resp.json();
            if (resp.ok && res.success) {
                window.location.reload();
            } else {
                alert('Error: ' + (res.message || 'Cannot delete department with active members.'));
            }
        } catch (e) {
            alert('Network error: ' + e.message);
        }
    }

    function openAddMemberModal() {
        if (!canEdit) return;
        document.getElementById('modal-add-member').style.display = 'flex';
    }

    function closeAddMemberModal() {
        document.getElementById('modal-add-member').style.display = 'none';
    }

    async function confirmAddMember() {
        if (!canEdit) {
            alert('Access denied: You have view-only permission.');
            return;
        }
        if (!currentDeptId) return;
        const userId = document.getElementById('modal-select-user').value;
        if (!userId) return;

        try {
            const resp = await fetch('?handler=AssignMemberJson', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: JSON.stringify({ departmentId: currentDeptId, userId: userId })
            });

            const res = await resp.json();
            if (resp.ok && res.success) {
                window.location.reload();
            } else {
                alert('Error: ' + (res.message || 'Failed to assign member.'));
            }
        } catch (e) {
            alert('Network error: ' + e.message);
        }
    }

    async function removeMember(userId, userName) {
        if (!canEdit) {
            alert('Access denied: You have view-only permission.');
            return;
        }
        if (!currentDeptId) return;
        if (!confirm(`Remove ${userName} from this department?`)) return;

        try {
            const resp = await fetch('?handler=RemoveMemberJson', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: JSON.stringify({ departmentId: currentDeptId, userId: userId })
            });

            const res = await resp.json();
            if (resp.ok && res.success) {
                window.location.reload();
            } else {
                alert('Error: ' + (res.message || 'Failed to remove member.'));
            }
        } catch (e) {
            alert('Network error: ' + e.message);
        }
    }
</script>
}